# NOVA X — example environment configuration
#
# Copy to `.env` (git-ignored) for local server runs, or set these as secrets in
# your hosting platform. `.env` files are loaded by python-dotenv for the SERVER
# only; the native desktop build sets NOVA_DESKTOP_MODE=1 and deliberately ignores
# them because its credentials come from the Linux Secret Service keyring.
#
# Every value below is optional. Defaults are conservative and documented in
# README.md ("Configuration reference"). Never commit a populated `.env`.

# ─────────────────────────────────────────────────────────────────────────────
# Access control — set this before ANY public exposure
# ─────────────────────────────────────────────────────────────────────────────
# Single-user access gate. Blank = open local mode.
# Hugging Face Spaces (SPACE_ID set) fail closed at startup when this is blank.
NOVA_ACCESS_TOKEN=

# Session lifetime for the access-token cookie (seconds, 300–2592000).
#NOVA_SESSION_TTL_SECONDS=28800

# ─────────────────────────────────────────────────────────────────────────────
# Provider credentials (server-side environment only — never sent to a browser)
# ─────────────────────────────────────────────────────────────────────────────
# Managed model profiles store the NAME of one of these variables, not a key
# value. Add only the ones you actually use.
#OPENAI_API_KEY=
#ANTHROPIC_API_KEY=
#GEMINI_API_KEY=
#XAI_API_KEY=
#DEEPSEEK_API_KEY=
#MISTRAL_API_KEY=

# Environment-based default (legacy single-provider) configuration.
# AI_MODEL is intentionally blank: choose a model ID your account can see.
#AI_BASE_URL=https://api.openai.com/v1
#AI_API_KEY=
#AI_MODEL=
# Add `tools` only after validating tool calls for the selected model.
#AI_MODEL_CAPABILITIES=chat
#AI_TIMEOUT_SECONDS=45

# Endpoint safety. Both default to false and should stay false in production.
# Custom (non-official-host) endpoints ALSO require NOVA_ACCESS_TOKEN to be set,
# because they receive the configured credential.
#NOVA_ALLOW_CUSTOM_PROVIDER_ENDPOINTS=false
#NOVA_ALLOW_LOCAL_HTTP_PROVIDER=false

# Optional public web-search integration (billable; blank = disabled).
#TAVILY_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Storage locations
# ─────────────────────────────────────────────────────────────────────────────
# Treat these directories as sensitive: they hold conversations, tasks, audit
# history, and command logs. The Docker image uses /data/nova.
#NOVA_DATA_DIR=./data
#NOVA_DB_PATH=
#NOVA_WORKSPACE_DIR=./workspace

# ─────────────────────────────────────────────────────────────────────────────
# Intelligence modes and orchestration bounds
# ─────────────────────────────────────────────────────────────────────────────
# fast | balanced | frontier_fusion | maximum_intelligence
#NOVA_DEFAULT_INTELLIGENCE_MODE=balanced
#NOVA_MAX_FUSION_MODELS=3
#NOVA_MAX_INTELLIGENCE_REQUESTS=7
#NOVA_MAX_MODEL_CONCURRENCY=3
#NOVA_MAX_MODEL_FALLBACKS=1
#NOVA_MAX_INTELLIGENCE_SECONDS=180
#NOVA_MAX_FUSION_OUTPUT_TOKENS=1200
# Estimated-cost ceiling; enforced only when every participant profile has rates
# configured. 0 disables the estimate ceiling.
#NOVA_MAX_FUSION_BUDGET_USD=1.0

# ─────────────────────────────────────────────────────────────────────────────
# Autonomy policy and task runner bounds
# ─────────────────────────────────────────────────────────────────────────────
# assisted (A) | routine (B, default) | advanced (C) | high (D)
# C/D never unlock unavailable features or high-impact permissions.
#NOVA_AUTONOMY_LEVEL=routine
#NOVA_MAX_TASK_STEPS=8
#NOVA_MAX_AI_REQUESTS_PER_TASK=12
#NOVA_MAX_AI_REQUESTS_PER_MINUTE=20
#NOVA_MAX_RETRIES=1
#NOVA_MAX_TASK_SECONDS=240
#NOVA_MAX_PARALLEL_TASKS=1
#NOVA_MAX_TOOL_OUTPUT_CHARS=12000
#NOVA_MAX_CONTEXT_CHARS=100000
#NOVA_MAX_REQUEST_CHARS=12000
#NOVA_MAX_FILE_BYTES=524288
#NOVA_MAX_CHAT_HISTORY_MESSAGES=20
# Spend a provider call on evidence review when tool evidence exists.
#NOVA_VERIFY_TASKS=true
#NOVA_LOW_RESOURCE_MODE=true

# ─────────────────────────────────────────────────────────────────────────────
# Configured-goal scheduler (runs in-process only; host sleep pauses it)
# ─────────────────────────────────────────────────────────────────────────────
#NOVA_GOAL_SCHEDULER_ENABLED=true
#NOVA_GOAL_SCHEDULER_POLL_SECONDS=30
# Cap on automatically scheduled goal tasks per UTC day. 0 disables dispatch.
#NOVA_MAX_SCHEDULED_GOAL_RUNS_PER_DAY=5
