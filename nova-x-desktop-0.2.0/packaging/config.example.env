# NOVA X Unified Universal AI Operating System — Configuration Template
# Never commit real API keys to git. Store cloud credentials in Linux Secret Service
# via the native NOVA X Models & Credentials screen (`nova-x`).

# Scoped paths (defaults to XDG ~/.local/share/nova-x)
# NOVA_DATA_DIR=/home/kali/.local/share/nova-x
# NOVA_WORKSPACE_DIR=/home/kali/.local/share/nova-x/workspace

# Dual-core / ~10 GB RAM resource discipline
NOVA_LOW_RESOURCE_MODE=true
NOVA_VERIFY_TASKS=true
NOVA_MAX_MODEL_CONCURRENCY=2
NOVA_MAX_PARALLEL_TASKS=1
NOVA_MAX_TASK_STEPS=8
NOVA_MAX_TASK_SECONDS=120
NOVA_MAX_FUSION_BUDGET_USD=0.50

# Optional local AI runtime (Ollama loopback HTTP, keyless; <= 3B quantized models recommended on 10 GB RAM)
# Start separately only when needed: `ollama serve` (binds 127.0.0.1:11434)
